{
  "name": "pdf",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "pdf : fusionner, decouper et scinder des PDF dans le navigateur, avec une grille de vignettes zoomable.",
  "keywords": [
    "pdf",
    "merge",
    "split",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bertrandra/pdf.git"
  },
  "engines": {
    "node": ">=20.16"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src tests",
    "cliquet": "node scripts/cliquet.mjs",
    "verifier": "npm run typecheck && npm run lint && npm run cliquet && npm test",
    "construire": "node scripts/construire.mjs",
    "servir": "node scripts/servir.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "axe-core": "4.14.0",
    "esbuild": "0.24.2",
    "eslint": "^9.17.0",
    "playwright": "1.56.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "7.0.0"
  }
}
